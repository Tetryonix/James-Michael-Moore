\begin{align}
  \nuvac &= \frac{c}{\lq} \quad &\text{(no freedom)} \\
  s &= \frac{\lq}{c} \quad &\text{(no freedom)} \\
  \Aq &= \frac{\lq^{2}}{\sqrt{3}} \quad &\text{(Pythagorean forced, no freedom)} \\
  \mz &= \frac{h_{\mathrm{geo}} \cdot 1\,\mathrm{Hz}}{c^{2}} \quad
       &\text{(fixed by Carbon-12 topology)} \\
  h &= \mz \cdot c^{2} \cdot T \quad &\text{(no freedom)}

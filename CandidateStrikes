python3 << 'EOF'
import math

# All constants
lq = 1e-15
c = 299792458
h = 6.629432672e-34
mz = h / c**2
mp = 1.6726219e-27
sqrt3 = math.sqrt(3)
L = 2/sqrt3 * lq
Aq = lq**2 / sqrt3
nu_vac = c / lq
s = lq / c

print("=== ALL VERIFIED CONSTANTS ===")
print(f"lq       = {lq:.15e} m")
print(f"L        = {L:.15e} m")
print(f"Aq       = {Aq:.15e} m^2")
print(f"mz       = {mz:.15e} kg")
print(f"h        = {h:.15e} J·s")
print(f"nu_vac   = {nu_vac:.15e} Hz")
print(f"s        = {s:.15e} s")
print(f"c        = {c} m/s")
print()

# THE CORE PROOF: digit harmony
# nu_vac = c/lq
# For digits of nu_vac to match digits of c:
# nu_vac = c * 10^15 (if lq = 10^-15)
# This requires lq = 10^n for integer n
# Near proton scale only 10^-15 works

print("=== DIGIT HARMONY PROOF ===")
print()
print("nu_vac = c / lq")
print("For digit harmony: nu_vac digits must equal c digits")
print("This requires: c / lq = c * 10^k for some integer k")
print("Therefore: lq = 10^-k exactly")
print()
print("Testing all candidate lq values near proton scale:")
print()

# Test a fine grid
candidates = [
    (0.841e-15, "0.8410 fm (CODATA low)"),
    (0.8414e-15, "0.8414 fm (muonic H)"),
    (0.866e-15, "0.8660 fm (sqrt3/2, inscribed)"),
    (0.877e-15, "0.8770 fm (electron scatter)"),
    (0.999e-15, "0.9990 fm"),
    (1.000e-15, "1.0000 fm = 10^-15 m EXACT"),
    (1.001e-15, "1.0010 fm"),
    (1.088e-15, "1.0880 fm (solid of revolution)"),
    (1.1547e-15, "1.1547 fm (L = 2/sqrt3)"),
    (1.322e-15, "1.3221 fm (proton Compton)"),
]

c_digits = "299792458"
print(f"c = {c_digits} m/s")
print()
print(f"{'Candidate lq':<30} {'nu_vac (Hz)':<30} {'Leading digits':<20} {'Match?'}")
print("-"*100)
for lq_t, label in candidates:
    nu_t = c / lq_t
    nu_str = f"{nu_t:.8e}"
    # extract significant digits
    mantissa = f"{nu_t / 10**math.floor(math.log10(nu_t)):.8f}".replace('.','')
    c_mantissa = "299792458"
    match = mantissa[:9] == c_mantissa
    print(f"{label:<30} {nu_str:<30} {mantissa[:9]:<20} {'YES ✓' if match else 'NO ✗'}")

print()
print("=== N BOSONS IN LIGHT SECOND ===")
print()
light_second = c * 1.0  # metres
for lq_t, label in candidates:
    N = light_second / lq_t
    is_integer = abs(N - round(N)) < 0.5
    rational = abs(N - round(N)) / N
    print(f"{label:<35} N = {N:.10e}  irrational excess: {rational:.6e}")

print()
print("=== THE IRRATIONALITY PROOF ===")
print()
print("In one light-second there are exactly N gauge bosons:")
print("  N = c * T / lq  where T = 1s")
print()
print("For N to be a rational integer multiple:")
print("  lq must divide c*T = 299,792,458 m exactly")
print()
print("c*T = 299,792,458 m")
print("lq  = 1e-15 m = 10^-15 m")
print(f"N   = 299,792,458 / 10^-15 = {c/1e-15:.0f}")
print()
print("Any lq' != 10^-15 m gives irrational N:")
for lq_t, label in [(0.866e-15,"0.866 fm"),(0.8414e-15,"0.8414 fm"),(1.1547e-15,"1.1547 fm")]:
    N = c / lq_t
    print(f"  lq={label}: N = {N:.10e} -- not an integer power")

print()
print("=== GEOMETRIC MEAN EXACTNESS ===")
r_ins = sqrt3/2 * 1e-15
r_circ = 2/sqrt3 * 1e-15
gm = math.sqrt(r_ins * r_circ)
print(f"Inscribed radius  = sqrt3/2 * lq = {r_ins:.15e} m")
print(f"Circumscribed radius = 2/sqrt3*lq = {r_circ:.15e} m")
print(f"Geometric mean = sqrt(r_ins * r_circ) = {gm:.15e} m")
print(f"lq exact       = {1e-15:.15e} m")
print(f"Match to 15 sig figs: {abs(gm - 1e-15) < 1e-30}")

print()
print("=== h RECOVERY ===")
h_check = mz * c**2
print(f"mz * c^2 = {h_check:.15e} J·s")
print(f"h_geo    = {h:.15e} J·s")
print(f"Match: {abs(h_check - h) < 1e-48}")

EOF

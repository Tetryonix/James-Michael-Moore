bash

python3 << 'EOF'
from decimal import Decimal, getcontext
import math
getcontext().prec = 50

c = Decimal('1e-15')  # hypotenuse = fascia height
a = c / Decimal('2')  # vertical leg = c/2

# Pythagoras: b = sqrt(c^2 - a^2)
b = (c**2 - a**2).sqrt()

print(f"c (hypotenuse)  = {c} m")
print(f"a (vertical)    = {a} m")
print(f"b (horizontal)  = {b} m")
print(f"b               = {b*Decimal('1e15')} fm")
print(f"b = c*sqrt(3)/2 = {c * Decimal('3').sqrt() / Decimal('2')} m")
print(f"angle at base   = {math.degrees(math.asin(float(a/c))):.4f}°")

EOF
